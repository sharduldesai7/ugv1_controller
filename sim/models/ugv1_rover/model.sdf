    <collision name="chassis"><pose>0 0 -0.045 0 0 0</pose><geometry><box><size>0.26 0.2 0.05</size></box></geometry></collision>
    <visual name="chassis"><pose>0 0 -0.045 0 0 0</pose><geometry><box><size>0.26 0.2 0.05</size></box></geometry>
      <material><ambient>0.15 0.35 0.6 1</ambient><diffuse>0.2 0.45 0.75 1</diffuse></material></visual>
    <collision name="caster_front"><pose>0.1 0 -0.0675 0 0 0</pose><geometry><sphere><radius>0.0325</radius></sphere></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    <visual name="caster_front"><pose>0.1 0 -0.0675 0 0 0</pose><geometry><sphere><radius>0.0325</radius></sphere></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
    <collision name="caster_rear"><pose>-0.1 0 -0.0675 0 0 0</pose><geometry><sphere><radius>0.0325</radius></sphere></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    <visual name="caster_rear"><pose>-0.1 0 -0.0675 0 0 0</pose><geometry><sphere><radius>0.0325</radius></sphere></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
    <visual name="lidar_housing"><pose>-0.0835 -0.0063 0.0947 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
      <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>

    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 3.14159</pose>
      <always_on>1</always_on><update_rate>100</update_rate><visualize>false</visualize>
      <topic>/imu/data_raw</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001134</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>3.67423e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001134</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>3.67423e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001134</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>3.67423e-05</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0075</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.000979796</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0075</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.000979796</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0075</stddev><bias_mean>0.0</bias_mean><bias_stddev>0.0</bias_stddev><dynamic_bias_stddev>0.000979796</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>

    <sensor name="camera" type="camera">
      <pose>0.0665009 -0.00626907 0.0147492 -0.00148569 -0.137254 0.00731755</pose>
      <always_on>1</always_on><update_rate>15</update_rate><visualize>false</visualize>
      <topic>/video_raw_raw</topic>
      <gz_frame_id>camera_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.357818</horizontal_fov>
        <image><width>640</width><height>480</height><format>L8</format></image>
        <clip><near>0.05</near><far>40</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>

    <sensor name="lidar" type="gpu_lidar">
      <pose>-0.0835 -0.0063 0.0947 0 0 3.14159</pose>
      <always_on>1</always_on><update_rate>7.4</update_rate><visualize>false</visualize>
      <topic>/scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <lidar>
        <scan><horizontal><samples>720</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </lidar>
    </sensor>
  </link>

  <link name="left_wheel_link">
    <pose>0 0.11 -0.0675 -1.5708 0 0</pose>
    <inertial><mass>0.08</mass><inertia><ixx>2.37917e-05</ixx><iyy>2.37917e-05</iyy><izz>4.225e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <collision name="collision"><geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    <visual name="visual"><geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
  </link>
  <joint name="left_wheel_joint" type="revolute">
    <parent>base_link</parent><child>left_wheel_link</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
  </joint>
  <link name="right_wheel_link">
    <pose>0 -0.11 -0.0675 -1.5708 0 0</pose>
    <inertial><mass>0.08</mass><inertia><ixx>2.37917e-05</ixx><iyy>2.37917e-05</iyy><izz>4.225e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <collision name="collision"><geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    <visual name="visual"><geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
  </link>
  <joint name="right_wheel_joint" type="revolute">
    <parent>base_link</parent><child>right_wheel_link</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
  </joint>

  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.22</wheel_separation>
    <wheel_radius>0.0325</wheel_radius>
    <topic>/cmd_vel</topic>
    <odom_topic>/wheel_odom</odom_topic>
    <tf_topic>/sim/wheel_odom_tf</tf_topic>
    <frame_id>odom_wheel</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <odom_publish_frequency>20</odom_publish_frequency>
    <max_linear_acceleration>1.0</max_linear_acceleration>
    <min_linear_acceleration>-1.0</min_linear_acceleration>
    <max_angular_acceleration>3.0</max_angular_acceleration>
    <min_angular_acceleration>-3.0</min_angular_acceleration>
  </plugin>

  <!-- Ground truth for scoring the estimator: pose of base_link in the world -->
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <odom_frame>world</odom_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <odom_topic>/ground_truth/odom</odom_topic>
    <tf_topic>/sim/ground_truth_tf</tf_topic>
    <odom_publish_frequency>50</odom_publish_frequency>
    <dimensions>3</dimensions>
  </plugin>
</model>
</sdf>
